# Doxyfile.in

PROJECT_NAME           = "R-Type Project"
OUTPUT_DIRECTORY       = ./docs
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_RTF           = NO
INPUT                  = ./client/include \
                        ./client/src \
                        ./ecs/include/components \
                        ./ecs/include/systems \
                        ./ecs/include/display \
                        ./ecs/include \
                        ./ecs/src/display \
                        ./ecs/src/system \
                        ./ecs/src \
                        ./server/include \
                        ./server/src \
                        ./utils
RECURSIVE              = YES
EXTRACT_ALL            = YES
